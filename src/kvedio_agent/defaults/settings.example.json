{
  // Connection that reads the recording and answers questions about it. Required.
  // One provider may back both capabilities; repeat its details under "asr" to do so.
  "video": {
    // Provider model identifier; replace every REPLACE_WITH_* value before use.
    "model": "REPLACE_WITH_VIDEO_MODEL_ID",
    // OpenAI-compatible API base URL. Omit only when the SDK has a provider default.
    "base_url": "https://REPLACE_WITH_PROVIDER_ENDPOINT/v1",
    // Provider API key. Keep this user-owned file private.
    "api_key": "REPLACE_WITH_VIDEO_API_KEY",
    // Per-call timeout in seconds and maximum attempts for one call.
    "timeout_seconds": 120,
    "max_attempts": 3,
    // Requests per minute allowed against this connection; null means no local limit.
    "requests_per_minute": null,
    // USD per million input/output tokens; null means the price is unknown.
    "input_cost_per_million": null,
    "output_cost_per_million": null,
    // USD per audio minute; null means the price is unknown.
    "audio_cost_per_minute": null,
    // Input tokens one second of clip is billed for, and the media tokens one
    // observation call may spend. Together they set the window read per call;
    // null leaves max_segment_duration_seconds as the window.
    "video_tokens_per_second": null,
    "video_budget_tokens": null
  },
  // Connection that transcribes audio. Delete this object to leave speech untranscribed.
  "asr": {
    "model": "REPLACE_WITH_ASR_MODEL_ID",
    "base_url": "https://REPLACE_WITH_PROVIDER_ENDPOINT/v1",
    "api_key": "REPLACE_WITH_ASR_API_KEY",
    // Transcription requests may take longer than text requests.
    "timeout_seconds": 300,
    "max_attempts": 3,
    "requests_per_minute": null,
    "input_cost_per_million": null,
    "output_cost_per_million": null,
    "audio_cost_per_minute": null
  },
  // Runtime limits. Worker counts cap concurrent local and provider work.
  "runtime": {
    // Maximum accepted source video duration in seconds.
    "max_video_duration_seconds": 7200,
    // Generated job artifacts retained before cleanup; source videos are not removed.
    "retention_days": 30,
    // Media segment window and overlap, in seconds.
    "max_segment_duration_seconds": 120,
    "segment_overlap_seconds": 2,
    // Frames kept per second of clip, and the clip width ceiling in pixels. A video
    // model is billed for frames, so these set the price of observing one window.
    "clip_frames_per_second": 1.0,
    "clip_max_width": 640,
    // Observations kept from one clip, at most.
    "max_clip_events": 12,
    // Maximum concurrent preprocessing, transcription, and video work units.
    "max_media_workers": 2,
    "max_asr_workers": 4,
    "max_video_workers": 2,
    // Global concurrency ceiling across work stages.
    "max_global_workers": 6,
    // Per-job USD spend ceiling; null means no configured ceiling.
    "max_job_cost_usd": null
  }
}
